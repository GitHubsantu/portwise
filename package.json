{
  "name": "portwise",
  "displayName": "Portwise: Codex Account & Provider Switcher",
  "description": "Switch Codex accounts and manage OpenAI-compatible providers, with a local gateway that stays on the right port.",
  "version": "0.1.0",
  "publisher": "santu-dev",
  "license": "MIT",
  "author": "Dharanidhar Mahata",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitHubsantu/portwise.git"
  },
  "homepage": "https://github.com/GitHubsantu/portwise#readme",
  "bugs": {
    "url": "https://github.com/GitHubsantu/portwise/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "account switcher",
    "multi account",
    "provider",
    "gateway",
    "proxy",
    "profiles"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20.19.0"
  },
  "icon": "images/icon-128.png",
  "galleryBanner": {
    "color": "#0B1F2A",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "portwise.openPanel",
        "title": "Open Panel",
        "category": "Portwise",
        "icon": "$(plug)"
      },
      {
        "command": "portwise.refresh",
        "title": "Refresh",
        "category": "Portwise",
        "icon": "$(refresh)"
      },
      {
        "command": "portwise.showLogs",
        "title": "Show Logs",
        "category": "Portwise",
        "icon": "$(output)"
      },
      {
        "command": "portwise.startGateway",
        "title": "Start Gateway",
        "category": "Portwise"
      },
      {
        "command": "portwise.stopGateway",
        "title": "Stop Gateway",
        "category": "Portwise"
      },
      {
        "command": "portwise.restartGateway",
        "title": "Restart Gateway",
        "category": "Portwise"
      },
      {
        "command": "portwise.configureCodex",
        "title": "Configure Codex for Gateway",
        "category": "Portwise"
      },
      {
        "command": "portwise.runDiagnostics",
        "title": "Run Diagnostics",
        "category": "Portwise"
      },
      {
        "command": "portwise.restoreConfig",
        "title": "Restore Config Backup",
        "category": "Portwise"
      },
      {
        "command": "portwise.switchToGateway",
        "title": "Switch Codex to Portwise Gateway",
        "category": "Portwise"
      },
      {
        "command": "portwise.startCodexLogin",
        "title": "Add Account via Codex Login",
        "category": "Portwise"
      },
      {
        "command": "portwise.saveCodexAccount",
        "title": "Save Current Codex Account",
        "category": "Portwise"
      },
      {
        "command": "portwise.switchCodexAccount",
        "title": "Switch Codex Account",
        "category": "Portwise"
      },
      {
        "command": "portwise.removeCodexAccount",
        "title": "Remove Saved Codex Account",
        "category": "Portwise"
      },
      {
        "command": "portwise.openCodexUsage",
        "title": "Open Codex Usage",
        "category": "Portwise"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portwise",
          "title": "Portwise",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "portwise": [
        {
          "type": "webview",
          "id": "portwise.panel",
          "name": "Portwise"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "portwise.getStarted",
        "title": "Get started with Portwise",
        "description": "Set up Portwise in three steps. You can close this walkthrough and return later.",
        "steps": [
          {
            "id": "portwise.getStarted.openPanel",
            "title": "Open the Portwise panel",
            "description": "Review provider profiles and gateway status. [Open Portwise panel](command:portwise.openPanel)",
            "media": {
              "markdown": "media/walkthrough/open-panel.md"
            },
            "completionEvents": ["onCommand:portwise.openPanel"]
          },
          {
            "id": "portwise.getStarted.startGateway",
            "title": "Start the loopback gateway",
            "description": "Start Portwise before configuring Codex. [Start gateway](command:portwise.startGateway)",
            "media": {
              "markdown": "media/walkthrough/start-gateway.md"
            },
            "completionEvents": ["onCommand:portwise.startGateway"]
          },
          {
            "id": "portwise.getStarted.configureCodex",
            "title": "Configure a Codex home",
            "description": "Confirm the exact Codex-home path before Portwise writes its managed settings. [Configure Codex home](command:portwise.configureCodex)",
            "media": {
              "markdown": "media/walkthrough/configure-codex.md"
            },
            "completionEvents": ["onCommand:portwise.configureCodex"]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "portwise.refresh",
          "when": "view == portwise.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Portwise",
      "properties": {
        "portwise.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path of the Codex home directory. Leave empty to use `$CODEX_HOME` or `~/.codex`. Machine-scoped on purpose: a workspace can never override it."
        },
        "portwise.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "scope": "machine",
          "description": "Verbosity of the Portwise output channel. Secrets are always redacted."
        },
        "portwise.gatewayPort": {
          "type": "number",
          "default": 47831,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine",
          "description": "Stable loopback port for the Portwise gateway."
        },
        "portwise.autoStartGateway": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Start the detached Portwise gateway after activation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/webview-ui/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "npm run build:prod && node scripts/runIntegrationTests.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "verify": "npm run check && npm run build:prod && npm run package",
    "personalize": "node scripts/personalize.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.106.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "toml": "5.0.1"
  }
}
